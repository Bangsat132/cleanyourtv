<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Two permissions, both for the reading: INTERNET for the Open-Meteo call, and ACCESS_NETWORK_STATE because the
         30 minute job asks for a network before it runs, which Android refuses to schedule without it. No location
         permission: the city is written in res/values/options.xml, so the TV never asks where it is. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- The page, and the launcher's card: a card's picture is its activity's banner, and it has to sit on an
             activity with MAIN and LEANBACK_LAUNCHER that is exported, enabled and the only card in the package
             (docs/specs/card.md). Opening it shows the reading the wallpaper was chosen from. -->
        <activity
            android:name=".WallpaperActivity"
            android:banner="@drawable/card_banner"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data
                android:name="com.gathin.tvhome.card"
                android:resource="@xml/module_card" />
        </activity>

        <!-- The picture and the line the launcher reads (the launcher's live_wallpaper). Read only, two paths, no
             permission, no grant: nothing here can be written or listed. -->
        <provider
            android:name=".WallpaperProvider"
            android:authorities="${applicationId}.cardart"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- The 30 minute reading, which is also what keeps the picture current: a job, not a service, so the system
             runs it, it fetches once and stops. -->
        <service
            android:name=".WallpaperJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
