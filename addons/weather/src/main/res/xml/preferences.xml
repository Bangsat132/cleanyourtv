<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="API Configuration">
        <EditTextPreference
            android:key="api_key"
            android:title="@string/pref_api_key_title"
            android:summary="@string/pref_api_key_summary"
            android:dialogTitle="@string/pref_api_key_title"
            android:inputType="text"
            android:maxLines="1" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Location">
        <ListPreference
            android:key="location_mode"
            android:title="@string/pref_location_mode_title"
            android:summary="@string/pref_location_mode_summary"
            android:dialogTitle="@string/pref_location_mode_title"
            android:entries="@array/location_mode_entries"
            android:entryValues="@array/location_mode_values"
            android:defaultValue="gps" />
        <EditTextPreference
            android:key="manual_city"
            android:title="@string/pref_manual_city_title"
            android:summary="@string/pref_manual_city_summary"
            android:dialogTitle="@string/pref_manual_city_title"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:visible="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Display">
        <ListPreference
            android:key="units"
            android:title="@string/pref_units_title"
            android:summary="@string/pref_units_summary"
            android:dialogTitle="@string/pref_units_title"
            android:entries="@array/units_entries"
            android:entryValues="@array/units_values"
            android:defaultValue="metric" />
        <ListPreference
            android:key="refresh_interval"
            android:title="@string/pref_refresh_title"
            android:summary="@string/pref_refresh_summary"
            android:dialogTitle="@string/pref_refresh_title"
            android:entries="@array/refresh_entries"
            android:entryValues="@array/refresh_values"
            android:defaultValue="5" />
    </PreferenceCategory>

</PreferenceScreen>